+// modchip Fractal-64 Q2_0 (30-byte block): weight j = g*16 + k (g in 0..3, k in 0..15)
+//   idx  = ((qs[k] >> 2g) & 3) | (((qh[k & 7] >> (2g + (k >> 3))) & 1) << 2)
+//   mult = 4 + nibble of scales[] for sub-block j>>3 (0..3 low nibbles, 4..7 high nibbles)
+//   w    = d * mult * kvalues_fractal3[idx]
+constant float kvalues_fractal3_f[8] = { -14.f, -8.f, -4.f, -1.f, 1.f, 4.f, 8.f, 14.f };
+
+static inline float q2_0_fractal_mult(device const block_q2_0 * xb, short sb) {
+    const uint8_t sc = xb->scales[sb & 3];
+    return (float)(4 + ((sb < 4) ? (sc & 0x0F) : (sc >> 4)));
+}
+
+static inline float q2_0_fractal_val(device const block_q2_0 * xb, short g, short k) {
+    const uint8_t lo2 = (xb->qs[k] >> (2*g)) & 3;
+    const uint8_t hi1 = (xb->qh[k & 7] >> (2*g + (k >> 3))) & 1;
+    return kvalues_fractal3_f[lo2 | (hi1 << 2)];
+}
+
